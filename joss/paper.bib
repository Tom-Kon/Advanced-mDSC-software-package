@article{VanDenMooter2001,
   abstract = {The objective of the present study was to characterize the glassy state of ketoconazole and to calculate its molecular mobility below the glass transition, with a view to further developing the use of modulated temperature differential scanning calorimetry (MTDSC) as a means of studying relaxation behavior. Particular emphasis is placed on identifying the in¯uence of the choice of experimental parameters on the measured values of both the glass transition temperature (T g) and the relaxation enthalpy magnitude. Amorphous ketoconazole was studied using an amplitude of AE0.212 K, a period of 40 s, and an underlying heating rate of 2 K/min. The correction required for the calculation of the relaxation endotherm magnitude (thèT g shift effect') was demonstrated and is discussed in terms of the mechanism underpinning this phenomenon. Similarly, the in¯uence of the choice of MTDSC experimental parameters on the measured T g was studied by varying the amplitude from AE0.011 to AE0.424 K and the period from 25 to 50 s. The in¯uence of the cooling rate from the melt on the magnitude of the relaxation endotherm and position of the glass transition was investigated. It was noted that the magnitude of the relaxation endotherm increased with slower cooling rates, this being ascribed to a combination of annealing during the cooling and heating cycle and a further facet of the T g shift effect. Annealing experiments were performed at aging temperatures T g-12±T g-42 K for periods ranging from 10 min up to 16 h. The relaxation behavior was characterized by ®tting the calculated extent of relaxation to the Williams±Watts equation. Overall, the study has highlighted theoretical and experimental issues that need to be considered when using both DSC and MTDSC for the calculation of relaxation times. ß},
   author = {Guy Van Den Mooter and Duncan Q.M. Craig and Paul G. Royall},
   doi = {10.1002/jps.1052},
   issn = {00223549},
   issue = {8},
   journal = {Journal of Pharmaceutical Sciences},
   keywords = {amorphous,ketoconazole,modulated temperature differential scanning calorimetry,molecular mobility},
   month = {8},
   pages = {996-1003},
   title = {Characterization of amorphous ketoconazole using modulated temperature differential scanning calorimetry},
   volume = {90},
   url = {https://linkinghub.elsevier.com/retrieve/pii/S0022354916307882},
   year = {2001}
}

